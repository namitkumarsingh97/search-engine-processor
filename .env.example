# --- Required ---------------------------------------------------------------
# The SAME database the Nexa API uses (the processor reads products and writes news into it).
MONGODB_URI=mongodb+srv://singhnamit83_db_user:hA00feMrhAYcy8Dx@my-search-engine-cluste.psmfhyt.mongodb.net/mini-search?appName=my-search-engine-cluster&retryWrites=true&w=majority

# --- Recommended ------------------------------------------------------------
# Protects POST /jobs/:name/run. If unset, the "run now" endpoint is disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROCESSOR_SECRET=67928df696e0418fa3fd7c40b0f9d9c67aa96846fa34deaefd3907f25f924480

# Read-only GitHub token (no scopes needed for public repos). Raises GitHub's limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# --- Optional ---------------------------------------------------------------
# Port for the health/status server (hosts like Render and Railway set PORT themselves).
PORT=4100

# Timezone the cron schedules are read in (IANA name), e.g. Asia/Kolkata. Default UTC.
CRON_TIMEZONE=UTC

# Run every enabled job once when the processor starts (1 = yes, 0 = no). Default 1.
RUN_JOBS_ON_START=1

# Per-job overrides. Names are the job name in capitals with dashes turned into underscores:
#   JOB_<NAME>_CRON     a cron expression, e.g. "0 */3 * * *"
#   JOB_<NAME>_ENABLED  0 to switch the job off
# JOB_NEWS_SYNC_CRON=0 */3 * * *
# JOB_NEWS_SYNC_ENABLED=1
# JOB_PRUNE_JOB_RUNS_CRON=30 3 * * *
