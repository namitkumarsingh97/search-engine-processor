{
  "name": "nexa-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on NestJS worker for Nexa: scheduled jobs (news sync, housekeeping) that share Nexa's MongoDB.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/mongoose": "10.0.10",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/schedule": "4.1.1",
    "cron": "3.1.7",
    "dotenv": "16.4.5",
    "mongoose": "8.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@types/express": "4.17.21",
    "@types/node": "20.14.11",
    "typescript": "5.5.4"
  }
}
